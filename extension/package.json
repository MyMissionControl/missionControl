{
  "name": "mission-control",
  "displayName": "Mission Control",
  "description": "Automated Software Engineering Factory — VSCode extension",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "missioncontrol",
          "title": "Mission Control",
          "icon": "media/zap.svg"
        }
      ]
    },
    "views": {
      "missioncontrol": [
        {
          "id": "missioncontrol.panel",
          "name": "Mission Control",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "missioncontrol.terminal",
        "title": "Mission Control: Open Terminal"
      },
      {
        "command": "missioncontrol.localhosts",
        "title": "Mission Control: Localhosts"
      },
      {
        "command": "missioncontrol.startOrchestrator",
        "title": "Mission Control: Start Orchestrator"
      },
      {
        "command": "missioncontrol.orchestratorContinue",
        "title": "Mission Control: Projects"
      },
      {
        "command": "missioncontrol.install",
        "title": "Mission Control: Install"
      },
      {
        "command": "missioncontrol.setup",
        "title": "Mission Control: Setup"
      },
      {
        "command": "missioncontrol.start",
        "title": "Mission Control: Start"
      },
      {
        "command": "missioncontrol.status",
        "title": "Mission Control: Status"
      },
      {
        "command": "missioncontrol.approve",
        "title": "Mission Control: Approve"
      },
      {
        "command": "missioncontrol.budget",
        "title": "Mission Control: Budget"
      },
      {
        "command": "missioncontrol.skills",
        "title": "Mission Control: View Skills"
      },
      {
        "command": "missioncontrol.teams",
        "title": "Mission Control: Teams"
      },
      {
        "command": "missioncontrol.accounts",
        "title": "Mission Control: Accounts"
      },
      {
        "command": "missioncontrol.settings",
        "title": "Mission Control: Settings"
      },
      {
        "command": "missioncontrol.dashboard",
        "title": "Mission Control: Open Dashboard"
      },
      {
        "command": "missioncontrol.dataView",
        "title": "Mission Control: Data View"
      },
      {
        "command": "missioncontrol.createRequirement",
        "title": "Mission Control: Create Requirement"
      },
      {
        "command": "missioncontrol.openObsidian",
        "title": "Mission Control: Open in Obsidian"
      },
      {
        "command": "missioncontrol.claude",
        "title": "Mission Control: Open Claude"
      },
      {
        "command": "missioncontrol.mirror",
        "title": "Mission Control: Open Claude (Chat)"
      },
      {
        "command": "missioncontrol.attachToClaude",
        "title": "Mission Control: Attach File/Image to Claude"
      },
      {
        "command": "missioncontrol.pasteImageToClaude",
        "title": "Mission Control: Paste Image from Clipboard to Claude"
      },
      {
        "command": "missioncontrol.attachToFocusedClaude",
        "title": "Mission Control: Attach File to Focused Claude"
      },
      {
        "command": "missioncontrol.mawToggle",
        "title": "Mission Control: Toggle maw ui"
      },
      {
        "command": "missioncontrol.pendingAsk",
        "title": "Mission Control: คำถามที่ agent รอคำตอบ"
      }
    ],
    "configuration": {
      "title": "Mission Control",
      "properties": {
        "missioncontrol.pendingAsk.enabled": {
          "type": "boolean",
          "default": true,
          "description": "เฝ้าดูจอของ Claude pane ทุกตัว แล้วเด้งกล่องตัวเลือกใน VS Code เมื่อ agent ถามคำถามแล้วค้างรอคำตอบอยู่ · ตอบกลับได้เลยสำหรับกล่องเลือกข้อเดียว"
        }
      }
    }
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/marked": "^4.3.2",
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "marked": "^4.3.0",
    "ws": "^8.21.0"
  }
}
